# Copy this file to .env and fill in real values. .env is gitignored, never commit it.

# ---------- Runtime ----------
# true = run without a visible browser window
HEADLESS=true
# Safety switch: payments are only submitted when this is exactly "true"
ALLOW_REAL_PAYMENTS=false

# ---------- Gmail (used to read login codes) ----------
# See docs/GMAIL_SETUP.md for how to get these
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# ---------- Cards ----------
# Cards are referenced by an alias. Add as many as you need: CARD_<ALIAS>_*
CARD_MAIN_HOLDER=NOMBRE APELLIDO
CARD_MAIN_NUMBER=4111111111111111
CARD_MAIN_EXPIRY_MONTH=12
CARD_MAIN_EXPIRY_YEAR=2030
CARD_MAIN_CVV=123

# ---------- ESPH (esph-sa.com) ----------
ESPH_EMAIL=you@gmail.com
# Payment method for this bill, and which card alias to use
ESPH_PAYMENT_METHOD=credit-card
ESPH_CARD=MAIN
# Gmail search used to find the login code email (https://support.google.com/mail/answer/7190)
ESPH_CODE_EMAIL_QUERY=from:esph-sa.com
